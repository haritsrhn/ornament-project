{
  "name": "ornament",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:shared": "npm run dev --workspace packages/shared",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace packages/shared",
    "build:backend": "npm run build:shared && npm run build --workspace backend",
    "build:frontend": "npm run build:shared && npm run build --workspace frontend",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace packages/shared --workspace backend",
    "format": "npm run format --workspace packages/shared --workspace backend",
    "format:check": "npm run format:check --workspace packages/shared --workspace backend",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0"
  }
}
