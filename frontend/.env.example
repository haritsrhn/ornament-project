# Contact details rendered on the public site.
#
# These are kept out of the repository so it can stay public without
# publishing a scrapable email address. Copy this file to .env.local and fill
# in the real values — .env.local is gitignored.
#
# Without them the site still builds and renders; it just shows placeholders.

NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_INSTAGRAM_NAME="Ornament Sourcing Agent"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@example"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"

# Comma-separated; each part renders as its own line in the footer.
NEXT_PUBLIC_ADDRESS="Bantul, Daerah Istimewa Yogyakarta, Indonesia"

NEXT_PUBLIC_SITE_DOMAIN="example.id"
